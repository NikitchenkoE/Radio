{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and synced settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id"]
    },
    "Track": {
      "title": "Track",
      "description": "User cloud synced studio track",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "artist": { "type": "string" },
        "fileName": { "type": "string" },
        "audioUrl": { "type": "string" },
        "durationSeconds": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title"]
    },
    "Playlist": {
      "title": "Playlist",
      "description": "User cloud synced studio playlist",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "trackIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name"]
    },
    "FavoriteStation": {
      "title": "FavoriteStation",
      "description": "User cloud synced favorite radio station",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "stationId": { "type": "string" },
        "stationName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "stationId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/users/{userId}/tracks/{trackId}": {
      "schema": "Track",
      "description": "User cloud music tracks"
    },
    "/users/{userId}/playlists/{playlistId}": {
      "schema": "Playlist",
      "description": "User cloud playlists"
    },
    "/users/{userId}/favorites/{stationId}": {
      "schema": "FavoriteStation",
      "description": "User favorite radio stations"
    }
  }
}
